# Railpack picks this file up instead of its default SPA Caddyfile.
# Same as the default (port, /health, gzip/zstd, per-tool index.html) plus
# cross-origin isolation for multi-threaded ffmpeg and long-lived asset caching.
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		X-Content-Type-Options "nosniff"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "credentialless"
		-Server
	}

	# Hashed build output and the pinned model / OCR data never change under the same name.
	@hashed path /assets/* /models/* /tessdata/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Pages, the service worker and public files are revalidated so updates roll out.
	@fresh not path /assets/* /models/* /tessdata/*
	header @fresh Cache-Control "no-cache"

	root * {{.DIST_DIR}}

	file_server {
		hide .git
		hide .env*
	}

	encode {
		gzip
		zstd
	}

	try_files {path} {path}.html {path}/index.html /index.html
}
